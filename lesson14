import csv



with open("products.csv", "r", newline="") as csvfile:
    reader = csv.reader(csvfile, delimiter=",")

    customer = int(input("Minimum Price: "))

    headers = next(reader)

    with open("filtered_products.csv", "w", newline="") as new_file:
        writer = csv.writer(new_file, delimiter=",")

        writer.writerow(headers)

        for row in reader:
            price = float(row[1])

            if price > customer:
                writer.writerow(row)

