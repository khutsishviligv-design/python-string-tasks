# =====================================================
# PDF READER
# =====================================================

def read_pdf(file_path):

    reader = PdfReader(file_path)

    text = ""

    for page in reader.pages:

        page_text = page.extract_text()

        if page_text:
            text += page_text + "\n"

    return text


# =====================================================
# MARKDOWN READER
# =====================================================

def read_markdown(file_path):

    with open(
        file_path,
        "r",
        encoding="utf-8"
    ) as file:

        return file.read()


# =====================================================
# UNIVERSAL LOADER
# =====================================================

def load_document(file_path):

    extension = Path(
        file_path
    ).suffix.lower()

    if extension == ".pdf":
        return read_pdf(file_path)

    if extension == ".md":
        return read_markdown(file_path)

    raise ValueError(
        "Unsupported file format"
    )


# =====================================================
# SENTENCE CHUNKING
# =====================================================

def sentence_chunking(
    text,
    sentences_per_chunk=5
):

    sentences = re.split(
        r'(?<=[.!?])\s+',
        text.strip()
    )

    sentences = [
        sentence.strip()
        for sentence in sentences
        if sentence.strip()
    ]

    chunks = []

    for i in range(
        0,
        len(sentences),
        sentences_per_chunk
    ):

        chunk_text = " ".join(
            sentences[
                i:i + sentences_per_chunk
            ]
        )

        chunks.append({
            "chunk_index": len(chunks),
            "text": chunk_text
        })

    return chunks


# =====================================================
# SIMPLE EMBEDDING FUNCTION
# =====================================================

# OpenAI / HuggingFace embeddings

def get_embedding(text):

    vector = np.zeros(26)

    text = text.lower()

    for char in text:

        if "a" <= char <= "z":

            position = (
                ord(char)
                - ord("a")
            )

            vector[position] += 1

    norm = np.linalg.norm(vector)

    if norm != 0:
        vector = vector / norm

    return vector.tolist()


# =====================================================
# COSINE SIMILARITY
# =====================================================

def cosine_similarity(a, b):

    a = np.array(a)
    b = np.array(b)

    denominator = (
        np.linalg.norm(a)
        * np.linalg.norm(b)
    )

    if denominator == 0:
        return 0

    return np.dot(a, b) / denominator


# =====================================================
# SAVE CHUNKS
# =====================================================

def save_chunks(
    filename,
    chunks
):

    for chunk in chunks:

        embedding = get_embedding(
            chunk["text"]
        )

        cursor.execute(
            """
            INSERT INTO chunks
            (
                filename,
                chunk_index,
                content,
                embedding
            )
            VALUES
            (
                %s,
                %s,
                %s,
                %s
            )
            """,
            (
                filename,
                chunk["chunk_index"],
                chunk["text"],
                json.dumps(embedding)
            )
        )

    connection.commit()


# =====================================================
# SEARCH FUNCTION
# =====================================================

def search_chunks(
    query,
    top_k=3,
    threshold=0.50
):

    query_embedding = get_embedding(
        query
    )

    cursor.execute("""
        SELECT
            filename,
            chunk_index,
            content,
            embedding
        FROM chunks
    """)

    rows = cursor.fetchall()

    results = []

    for row in rows:

        filename = row[0]
        chunk_index = row[1]
        content = row[2]

        embedding = json.loads(
            row[3]
        )

        similarity = cosine_similarity(
            query_embedding,
            embedding
        )

        if similarity >= threshold:

            results.append({
                "filename": filename,
                "chunk_index": chunk_index,
                "content": content,
                "score": similarity
            })

    results.sort(
        key=lambda x: x["score"],
        reverse=True
    )

    return results[:top_k]


