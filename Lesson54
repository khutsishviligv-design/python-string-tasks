import os

from dotenv import load_dotenv
from pydantic import BaseModel, Field

from langchain_core.prompts import ChatPromptTemplate
from langchain_google_genai import ChatGoogleGenerativeAI



load_dotenv()


class FantasyQuest(BaseModel):
    quest_name: str
    hero_name: str
    enemy: str
    magical_item: str

    danger_level: int = Field(
        ge=1,
        le=10
    )

    reward: str
    side_quests: list[str]
    is_cursed: bool


llm = ChatGoogleGenerativeAI(
    model="gemini-3.6-flash"

)


prompt = ChatPromptTemplate.from_messages(
    [
        (
            "system",
            """
            შენ ხარ ეპიკური ფენტეზის თავგადასავლების შემქმნელი.

            მოთხოვნები:
            1. პასუხი უნდა იყოს მაქსიმალურად ეპიკური ფენტეზის სტილში.
            2. თუ მოცემულ ტექსტში რომელიმე ინფორმაცია აკლია,
               თავად მოიფიქრე ლოგიკური და საინტერესო დეტალი.
            3. danger_level უნდა იყოს 1-დან 10-მდე და რეალისტურად
               უნდა შეფასდეს ტექსტში აღწერილი საფრთხის მიხედვით.
            4. პასუხი აუცილებლად დააბრუნე მოცემული სტრუქტურის შესაბამისად.
            """
        ),
        (
            "human",
            """
            მოცემული ტექსტიდან შექმენი ფენტეზის დავალება:

            {text}
            """
        )
    ]
)


structured_llm = llm.with_structured_output(
    FantasyQuest
)


chain = prompt | structured_llm


result = chain.invoke(
    {
        "text": """
        ახალგაზრდა ჯადოქარი სახელად ლირა უნდა გაემგზავროს
        ჩრდილოეთის ტყეებში, რათა იპოვოს დაკარგული მთვარის ხმალი.
        გზად მას ელოდება უძველესი ტყის სული, რომელსაც სძულს ადამიანები.
        თუ წარმატებას მიაღწევს, მიიღებს უკვდავების ელექსირს.
        """
    }
)


print(result)
