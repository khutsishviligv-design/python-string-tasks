-- =========================================================
-- ნაწილი 2: JOIN მოთხოვნები
-- =========================================================


-- =========================================================
-- 1. ყველა შეკვეთის სრული ინფორმაცია
-- =========================================================

SELECT
    orders.id AS "OrderID",
    customers.name AS "CustomerName",
    customers.email AS "Email",
    products.product_name AS "ProductName",
    products.price AS "Price",
    order_items.quantity AS "Quantity",
    orders.order_date AS "OrderDate"
FROM orders
JOIN customers
    ON orders.customer_id = customers.id
JOIN order_items
    ON orders.id = order_items.order_id
JOIN products
    ON order_items.product_id = products.id
ORDER BY orders.id;


-- =========================================================
-- 2. მომხმარებლების და მათ მიერ შეკვეთილი პროდუქტების სია
-- =========================================================

SELECT
    customers.name AS "CustomerName",
    products.product_name AS "ProductName"
FROM customers
JOIN orders
    ON customers.id = orders.customer_id
JOIN order_items
    ON orders.id = order_items.order_id
JOIN products
    ON order_items.product_id = products.id
ORDER BY customers.id, orders.id, order_items.id;


-- =========================================================
-- 3. პროდუქტების სია და მათი მყიდველები
-- =========================================================

SELECT
    products.product_name AS "ProductName",
    products.price AS "Price",
    customers.name AS "CustomerName"
FROM products
JOIN order_items
    ON products.id = order_items.product_id
JOIN orders
    ON order_items.order_id = orders.id
JOIN customers
    ON orders.customer_id = customers.id
ORDER BY products.id;


-- =========================================================
-- 4. ყველა შეკვეთის დეტალური ინფორმაცია
-- =========================================================

SELECT
    orders.id AS "OrderID",
    customers.name AS "CustomerName",
    products.product_name AS "ProductName",
    order_items.quantity AS "Quantity",
    orders.order_date AS "OrderDate"
FROM orders
JOIN customers
    ON orders.customer_id = customers.id
JOIN order_items
    ON orders.id = order_items.order_id
JOIN products
    ON order_items.product_id = products.id
ORDER BY orders.id, order_items.id;


-- =========================================================
-- 5. ყველა პროდუქტი და მისი კატეგორია
-- =========================================================

SELECT
    products.product_name AS "ProductName",
    categories.category_name AS "Category"
FROM products
JOIN categories
    ON products.category_id = categories.id
ORDER BY products.id;


-- =========================================================
-- 6. Electronics კატეგორიის პროდუქტები
-- =========================================================

SELECT
    products.product_name AS "ProductName",
    categories.category_name AS "Category",
    products.price AS "Price"
FROM products
JOIN categories
    ON products.category_id = categories.id
WHERE categories.category_name = 'Electronics'
ORDER BY products.id;


-- =========================================================
-- 7. გიორგი ბერიძის შეკვეთები
-- =========================================================

SELECT
    orders.id AS "OrderID",
    customers.name AS "CustomerName",
    products.product_name AS "ProductName",
    order_items.quantity AS "Quantity"
FROM customers
JOIN orders
    ON customers.id = orders.customer_id
JOIN order_items
    ON orders.id = order_items.order_id
JOIN products
    ON order_items.product_id = products.id
WHERE customers.name = 'გიორგი ბერიძე'
ORDER BY orders.id, order_items.id;


-- =========================================================
-- 8. 2026-06-05 თარიღში გაყიდული პროდუქტები
-- =========================================================

SELECT
    orders.order_date AS "OrderDate",
    customers.name AS "CustomerName",
    products.product_name AS "ProductName",
    order_items.quantity AS "Quantity"
FROM orders
JOIN customers
    ON orders.customer_id = customers.id
