class rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height
    def area(self):
        return self.width * self.height
    def perimeter(self):
        return 2* (self.width + self.height)
    def is_square(self):
        return self.width == self.height

r1=rectangle(5,5)
print(r1.is_square())

