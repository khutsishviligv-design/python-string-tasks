class Book(BaseModel):
    title: str
    author: str
    year: int
    genres: list[str]


def get_book_recommendation(genre):
    """
    Gemini-სგან ითხოვს წიგნის რეკომენდაციას
    და პასუხს Book სტრუქტურაში იღებს.
    """

    prompt = f"""
    მირჩიე ერთი {genre} ჟანრის წიგნი.

    პასუხი უნდა შეიცავდეს:
    - წიგნის სათაურს;
    - ავტორს;
    - გამოცემის წელს;
    - ჟანრების სიას.

    დააბრუნე მხოლოდ ერთი წიგნი.
    """

    response = client.models.generate_content(
        model=MODEL_NAME,
        contents=prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
            response_schema=Book
        )
    )

    # Gemini SDK-ს მიერ უკვე დამუშავებული Pydantic ობიექტი
    book = response.parsed

    # დამატებითი შემოწმება
    if not isinstance(book, Book):
        book = Book.model_validate_json(response.text)

    return book


def run_task_3():
    print("\n" + "=" * 60)
    print("ამოცანა 3 — Structured Output")
    print("=" * 60)

    genre = "Mystery"

    try:
        book = get_book_recommendation(genre)

        print("\nმიღებული წიგნი:")
        print(f"Title: {book.title}")
        print(f"Author: {book.author}")
        print(f"Year: {book.year}")
        print(f"Genres: {', '.join(book.genres)}")

        print("\nJSON ფორმატი:")
        print(book.model_dump_json(indent=4))

    except ValidationError as error:
        print("Gemini-ის პასუხი Book მოდელს არ შეესაბამება.")
        print(error)

    except Exception as error:
        print(f"შეცდომა: {error}")




