def count_text_tokens(text):


    response = client.models.count_tokens(
        model=MODEL_NAME,
        contents=text
    )

    token_count = response.total_tokens

    print(f"ტოკენების რაოდენობა: {token_count}")

    if token_count == 0:
        print("ტექსტი ცარიელია ან ტოკენები ვერ მოიძებნა.")

    elif token_count > 300:
        print("გაფრთხილება: ტექსტი 300 ტოკენზე მეტია.")

    else:
        print("ტექსტის ზომა დასაშვებ ლიმიტშია.")

    return token_count


