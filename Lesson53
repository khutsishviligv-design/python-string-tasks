def trim_history(history: list, max_turns: int):
    """
    Conversation history-დან აბრუნებს
    მხოლოდ ბოლო max_turns შეტყობინებას.
    """

    if max_turns <= 0:
        return []

    return history[-max_turns:]


def history_to_text(history):


    history_lines = []

    for message in history:
        role = message["role"]
        content = message["content"]

        history_lines.append(f"{role}: {content}")

    return "\n".join(history_lines)


def count_history_tokens(history):
    """
    Conversation history-ის ტოკენების რაოდენობას ითვლის.
    """

    history_text = history_to_text(history)

    response = client.models.count_tokens(
        model=MODEL_NAME,
        contents=history_text
    )

    return response.total_tokens


