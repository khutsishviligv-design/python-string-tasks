-- 3. SELECT QUERIES

-- 3.1 All books
SELECT * FROM books;

-- 3.2 Book title and author
SELECT title, author
FROM books;

-- 3.3 Books with price greater than 30
SELECT *
FROM books
WHERE price > 30;

-- 3.4 Books published in 2020 or later
SELECT *
FROM books
WHERE publish_year >= 2020;

-- 3.5 Fantasy books
SELECT *
FROM books
WHERE genre = 'Fantasy';

-- 3.6 Books with more than 300 pages
SELECT *
FROM books
WHERE pages > 300;

-- 3.7 Books ordered by price ascending
SELECT *
FROM books
ORDER BY price ASC;

-- 3.8 Books ordered by publication year descending
SELECT *
FROM books
ORDER BY publish_year DESC;


-- 4. UPDATE DATA

-- 4.1 Change the price of one book
UPDATE books
SET price = 39.99
WHERE title = 'Atomic Habits';

-- Check the result
SELECT *
FROM books
WHERE title = 'Atomic Habits';


-- 4.2 Change the genre of one book
UPDATE books
SET genre = 'Philosophical Fiction'
WHERE title = 'The Alchemist';

-- Check the result
SELECT *
FROM books
WHERE title = 'The Alchemist';


-- 4.3 Change the number of pages of one book
UPDATE books
SET pages = 320
WHERE title = 'The Hobbit';

-- Check the result
SELECT *
FROM books
WHERE title = 'The Hobbit';


-- 5. DELETE DATA

