-- 1. CREATE TABLE

CREATE TABLE books (
    id SERIAL PRIMARY KEY,
    title VARCHAR(150),
    author VARCHAR(100),
    genre VARCHAR(50),
    publish_year INTEGER,
    pages INTEGER,
    price NUMERIC(8,2)
);


